<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Pedro Carranza | Full Stack Developer & Tech Lead</title>
    <link href="https://fonts.googleapis.com/css2?family=Fira+Code:wght@300;500&family=Inter:wght@300;400;700&family=Orbitron:wght@400;700&display=swap" rel="stylesheet">
    <style>
        :root {
            --bg-color: #0d0d0d;
            --terminal-green: #47d8a0;
            --accent-blue: #3498db;
            --text-white: #f4f4f4;
            --text-gray: #b0b0b0;
            --font-header: 'Orbitron', sans-serif;
            --font-code: 'Fira Code', monospace;
            --font-body: 'Inter', sans-serif;
        }

        body {
            background-color: var(--bg-color);
            color: var(--text-gray);
            font-family: var(--font-body);
            line-height: 1.6;
            margin: 0;
            padding: 20px;
        }

        .container {
            width: 100%;
            max-width: 900px;
            margin: 0 auto;
            position: relative;
            isolation: isolate;
            box-sizing: border-box;
        }

        .terminal-window {
            position: relative;
            z-index: 1;
            background: rgba(18, 18, 18, 0.48);
            border-radius: 12px;
            border: 1px solid #333;
            box-shadow: 0 25px 50px rgba(0,0,0,0.8);
            overflow: hidden;
            border-top: 1px solid #444;
        }

        .matrix-canvas {
            position: absolute;
            z-index: 0;
            top: 0;
            left: 0;
            width: 100%;
            opacity: 0.22;
            pointer-events: none;
            mask-image: linear-gradient(to bottom, transparent, #000 12%, #000 88%, transparent);
        }

        .terminal-header {
            position: relative;
            z-index: 1;
            background: #1a1a1a;
            padding: 15px 20px;
            display: flex;
            align-items: center;
            border-bottom: 2px solid #333;
        }

        .dot { height: 12px; width: 12px; border-radius: 50%; display: inline-block; margin-right: 8px; }
        .red { background: #ff5f56; }
        .yellow { background: #ffbd2e; }
        .green { background: #27c93f; }

        .terminal-title {
            font-family: var(--font-code);
            font-size: 0.85em;
            color: #666;
            margin-left: 10px;
        }

        .content {
            position: relative;
            z-index: 1;
            padding: 45px;
        }

        /* --- AJUSTE PARA LA FOTO --- */
        .bio-container {
            display: flex;
            gap: 30px;
            align-items: flex-start;
            flex-wrap: wrap; /* Para móviles */
        }

        .bio-photo {
            flex: 0 0 180px;
            position: relative;
        }

        .bio-photo img {
            width: 180px;
            height: 180px;
            object-fit: cover;
            border: 2px solid var(--accent-blue);
            border-radius: 8px;
            filter: grayscale(30%); /* Efecto profesional */
            transition: 0.3s ease;
        }

        .bio-photo:hover img {
            filter: grayscale(0%);
            box-shadow: 0 0 20px rgba(52, 152, 219, 0.4);
        }

        /* Indicador decorativo tipo scanner */
        .bio-photo::after {
            content: "";
            position: absolute;
            top: 0; left: 0; width: 100%; height: 2px;
            background: var(--terminal-green);
            opacity: 0.3;
            animation: scan 3s infinite linear;
        }

        @keyframes scan {
            0% { top: 0; }
            50% { top: 100%; }
            100% { top: 0; }
        }

        .bio-text { flex: 1; min-width: 280px; }
        /* --------------------------- */

        h1 {
            font-family: var(--font-header);
            color: var(--text-white);
            font-size: 2.8em;
            margin: 0;
            text-transform: uppercase;
            letter-spacing: 3px;
        }

        .highlight-blue { color: var(--accent-blue); }
        .highlight-green { color: var(--terminal-green); }

        .command-line {
            font-family: var(--font-code);
            margin-bottom: 20px;
            font-size: 0.9em;
        }

        .prompt { color: lab(55.0481% -49.9246 15.93); }
        .command { color: var(--text-white); font-weight: bold; }

        section { margin-bottom: 60px; }

        .section-tag {
            font-family: var(--font-code);
            color: var(--accent-blue);
            font-size: 0.8em;
            text-transform: uppercase;
            display: block;
            margin-bottom: 10px;
        }

        .capabilities-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 20px;
        }

        .cap-card {
            background: rgba(255, 255, 255, 0.03);
            padding: 25px;
            border-bottom: 3px solid var(--accent-blue);
            transition: 0.3s ease;
        }

        .cap-card:hover {
            background: rgba(52, 152, 219, 0.05);
            border-bottom-color: var(--terminal-green);
        }

        .cap-card h3 {
            font-family: var(--font-header);
            color: var(--text-white);
            font-size: 1em;
            margin-top: 0;
        }

        .skill-groups {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
            gap: 20px;
        }

        .skill-group,
        .project-card {
            background: rgba(255, 255, 255, 0.03);
            border: 1px solid #292929;
            border-radius: 8px;
            padding: 22px;
        }

        .skill-group h3,
        .project-card h3 {
            color: var(--text-white);
            font-family: var(--font-header);
            font-size: 0.95em;
            margin: 0 0 16px;
        }

        .skill-tags,
        .project-meta {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
        }

        .skill-tag,
        .project-tag {
            border: 1px solid rgba(52, 152, 219, 0.35);
            border-radius: 999px;
            color: #c9e8fa;
            font-family: var(--font-code);
            font-size: 0.75em;
            padding: 5px 10px;
        }

        .skills-tree {
            overflow-x: auto;
            margin: 0;
            padding: 22px;
            border: 1px solid #292929;
            border-radius: 8px;
            background: rgba(255, 255, 255, 0.03);
            color: var(--terminal-green);
            font-family: var(--font-code);
            font-size: 0.9em;
            line-height: 1.9;
        }

        .skills-tree span {
            display: block;
        }

        .projects-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
            gap: 18px;
        }

        .project-card {
            display: flex;
            flex-direction: column;
            min-height: 210px;
            transition: border-color 0.3s ease, background 0.3s ease;
        }

        .project-card:hover {
            background: rgba(52, 152, 219, 0.05);
            border-color: var(--accent-blue);
        }

        .project-card h3 a {
            color: inherit;
            text-decoration: none;
        }

        .project-card h3 a:hover {
            color: var(--terminal-green);
        }

        .project-card p {
            flex: 1;
            margin: 0 0 18px;
        }

        .project-card .project-meta {
            align-items: center;
            color: var(--text-gray);
            font-family: var(--font-code);
            font-size: 0.75em;
            margin-bottom: 14px;
        }

        .project-link {
            color: var(--accent-blue);
            font-family: var(--font-code);
            font-size: 0.8em;
            margin-top: 16px;
            text-decoration: none;
        }

        .project-link:hover {
            color: var(--terminal-green);
        }

        .projects-message {
            border-left: 2px solid var(--accent-blue);
            padding: 10px 16px;
        }

        .contributions-summary {
            color: var(--text-white);
            font-family: var(--font-code);
            margin-bottom: 16px;
        }

        .contributions-scroll {
            overflow-x: auto;
            padding: 18px;
            border: 1px solid #292929;
            border-radius: 8px;
            background: rgba(255, 255, 255, 0.03);
        }

        .contributions-calendar {
            display: flex;
            gap: 4px;
            width: max-content;
        }

        .contribution-week {
            display: grid;
            grid-template-rows: repeat(7, 12px);
            gap: 4px;
        }

        .contribution-day {
            width: 12px;
            height: 12px;
            border-radius: 2px;
            background: #202820;
        }

        .contribution-day[data-level="1"] { background: #0e4429; }
        .contribution-day[data-level="2"] { background: #006d32; }
        .contribution-day[data-level="3"] { background: #26a641; }
        .contribution-day[data-level="4"] { background: #39d353; }

        .contributions-legend {
            display: flex;
            align-items: center;
            justify-content: flex-end;
            gap: 5px;
            margin-top: 12px;
            color: var(--text-gray);
            font-family: var(--font-code);
            font-size: 0.75em;
        }

        .contributions-legend .contribution-day {
            display: inline-block;
        }

        .trace-item {
            border-left: 1px solid #333;
            padding-left: 30px;
            margin-left: 10px;
            position: relative;
            padding-bottom: 35px;
        }

        .trace-item::before {
            content: "";
            position: absolute; left: -5px; top: 5px; width: 9px; height: 9px;
            background: var(--terminal-green);
            border-radius: 50%;
            box-shadow: 0 0 10px var(--terminal-green);
        }

        .trace-status {
            font-family: var(--font-code);
            color: var(--terminal-green);
            font-size: 0.85em;
            font-weight: bold;
            text-transform: uppercase;
        }

        .action-area {
            display: flex; gap: 20px; flex-wrap: wrap; margin-top: 20px;
        }

        .btn-saeta {
            background: transparent;
            border: 1px solid var(--accent-blue);
            color: var(--accent-blue);
            padding: 12px 30px;
            font-family: var(--font-code);
            text-decoration: none;
            font-weight: bold;
            transition: 0.3s;
        }

        .btn-saeta:hover {
            background: var(--accent-blue);
            color: var(--text-white);
            box-shadow: 0 0 20px rgba(52, 152, 219, 0.4);
        }

        footer {
            position: relative;
            z-index: 1;
            text-align: center; padding: 40px 0; font-family: var(--font-code); font-size: 0.75em; opacity: 0.5;
        }

        @media (max-width: 600px) {
            h1 { font-size: 1.8em; }
            .content { padding: 25px; }
            .bio-container { justify-content: center; text-align: center; }
        }

        @media (prefers-reduced-motion: reduce) {
            .matrix-canvas { display: none; }
        }
    </style>
</head>
<body>

