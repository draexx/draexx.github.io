                                {project.topics.length > 0 && (
                                    <div class="project-meta">
                                        {project.topics.slice(0, 4).map((topic) => <span class="project-tag">#{topic}</span>)}
                                    </div>
                                )}
                                <a class="project-link" href={project.html_url} target="_blank" rel="noopener noreferrer">Ver repositorio →</a>
                            </article>
                        ))}
                    </div>
                ) : (
                    <p class="projects-message">No hay proyectos públicos para mostrar. <a class="project-link" href={githubProfileUrl}>Ver perfil en GitHub</a></p>
                )}
            </section>

                        <section id="contributions">
                <span class="section-tag">/ actividad en github /</span>
                <div class="command-line">
                    <span class="prompt">pedrocarranza@saeta:~$</span> <span class="command">gh api graphql --field contributionsCollection</span>
                </div>

                {contributionsError ? (
                    <p class="projects-message">
                        {contributionsErrorMessage}
                        <a class="project-link" href={`${githubProfileUrl}/graphs/contributors`} target="_blank" rel="noopener noreferrer">Ver actividad en GitHub</a>
                    </p>
                ) : (
                    <>
                        <p class="contributions-summary">{totalContributions.toLocaleString("es-BO")} contribuciones en el último año</p>
                        <div class="contributions-scroll" role="img" aria-label={`Calendario de ${totalContributions} contribuciones de GitHub durante el último año`}>
                            <div class="contributions-calendar">
                                {contributionWeeks.map((week) => (
                                    <div class="contribution-week">
                                        {week.contributionDays.map((day) => {
                                            const level = day.contributionCount === 0
                                                ? 0
                                                : day.contributionCount < 2
                                                    ? 1
                                                    : day.contributionCount < 5
                                                        ? 2
                                                        : day.contributionCount < 10
                                                            ? 3
                                                            : 4;
                                            const date = new Date(`${day.date}T00:00:00Z`).toLocaleDateString("es-BO", {
                                                year: "numeric",
                                                month: "long",
                                                day: "numeric",
                                                timeZone: "UTC",
                                            });

                                            return (
                                                <span
                                                    class="contribution-day"
                                                    data-level={level}
                                                    title={`${day.contributionCount} contribuciones · ${date}`}
                                                />
                                            );
                                        })}
                                    </div>
                                ))}
                            </div>
                            <div class="contributions-legend" aria-hidden="true">
                                <span>Menos</span>
                                {[0, 1, 2, 3, 4].map((level) => <span class="contribution-day" data-level={level} />)}
                                <span>Más</span>
                            </div>
                        </div>
                    </>
                )}
            </section>

            <div class="action-area">
                <a href="https://pedrocarranza.com/files/CV-Pedro-Carranza.pdf" class="btn-saeta" target="_blank">> VIEW_FULLSTACK_CV.PDF</a>
                <a href="https://pedrocarranza.com" class="btn-saeta">> VISIT_LABORATORY</a>
            </div>
        </div>
    </div>

    <footer>
        TECBA 2026 | RUNTIME: <span class="highlight-green">OPTIMIZED</span> | Full Stack Engineering
    </footer>
</div>

<script>
    const matrixCanvas = document.querySelector<HTMLCanvasElement>(".matrix-canvas");
    const matrixContainer = matrixCanvas?.parentElement;
    const matrixContext = matrixCanvas?.getContext("2d");
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

    if (matrixCanvas && matrixContainer && matrixContext && !reducedMotion.matches) {
        const glyphs = "01アイウエオカキクケコサシスセソタチツテト";
        const fontSize = 14;
        let drops: number[] = [];
        let animationFrame = 0;

        const resizeCanvas = () => {
            matrixCanvas.style.width = `${matrixContainer.clientWidth}px`;
            matrixCanvas.style.height = `${matrixContainer.scrollHeight}px`;
            const bounds = matrixCanvas.getBoundingClientRect();
            const pixelRatio = Math.min(window.devicePixelRatio || 1, 1.5);
            matrixCanvas.width = Math.floor(bounds.width * pixelRatio);
            matrixCanvas.height = Math.floor(bounds.height * pixelRatio);
            matrixContext.setTransform(pixelRatio, 0, 0, pixelRatio, 0, 0);
            drops = Array.from(
                { length: Math.ceil(bounds.width / fontSize) },
                () => Math.random() * (bounds.height / fontSize),
            );
            matrixContext.clearRect(0, 0, bounds.width, bounds.height);
        };

        const drawMatrix = () => {
            const bounds = matrixCanvas.getBoundingClientRect();
            matrixContext.fillStyle = "rgba(13, 13, 13, 0.08)";
            matrixContext.fillRect(0, 0, bounds.width, bounds.height);
            matrixContext.font = `${fontSize}px monospace`;

            drops.forEach((drop, column) => {
                const glyph = glyphs[Math.floor(Math.random() * glyphs.length)];
                matrixContext.fillStyle = Math.random() > 0.97 ? "#caffd5" : "#00ff41";
                matrixContext.fillText(glyph, column * fontSize, drop * fontSize);
                drops[column] = drop * fontSize > bounds.height && Math.random() > 0.975
                    ? 0
                    : drop + 0.45;
            });

            animationFrame = window.requestAnimationFrame(drawMatrix);
        };

        const stopMatrix = () => {
            window.cancelAnimationFrame(animationFrame);
            matrixContext.clearRect(0, 0, matrixCanvas.width, matrixCanvas.height);
        };

        resizeCanvas();
        drawMatrix();
        const resizeObserver = new ResizeObserver(resizeCanvas);
        resizeObserver.observe(matrixContainer);
        window.addEventListener("resize", resizeCanvas);
        reducedMotion.addEventListener("change", (event) => {
            if (event.matches) {
                stopMatrix();
            } else {
                resizeCanvas();
                drawMatrix();
            }
        });
    }
</script>

</body>
</html>
