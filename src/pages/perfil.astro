---
interface GithubRepository {
    name: string;
    html_url: string;
    homepage: string | null;
    description: string | null;
    language: string | null;
    stargazers_count: number;
    pushed_at: string;
    topics: string[];
    fork: boolean;
    archived: boolean;
}

interface GithubPinnedRepositoriesResponse {
    data?: {
        user?: {
            pinnedItems?: {
                nodes: {
                    name: string;
                    htmlUrl: string;
                    homepageUrl: string | null;
                    description: string | null;
                    primaryLanguage: { name: string } | null;
                    stargazerCount: number;
                    pushedAt: string;
                    repositoryTopics: { nodes: { topic: { name: string } }[] };
                    isFork: boolean;
                    isArchived: boolean;
                }[];
            };
        } | null;
    };
    errors?: { message: string }[];
}

interface GithubContributionDay {
    contributionCount: number;
    date: string;
}

interface GithubContributionWeek {
    contributionDays: GithubContributionDay[];
}

interface GithubContributionCalendar {
    totalContributions: number;
    weeks: GithubContributionWeek[];
}

interface GithubContributionsResponse {
    data?: {
        user?: {
            contributionsCollection?: {
                contributionCalendar: GithubContributionCalendar;
            };
        } | null;
    };
    errors?: { message: string }[];
}

const skills = [
    {
        title: "Lenguajes",
        items: ["C++", "GDScript", "HTML", "Java", "JavaScript", "PHP", "PL/pgSQL", "Python", "Shell", "TypeScript", "Wolfram Language"],
    },
    {
        title: "Frameworks & librerías",
        items: ["Astro", "Next.js", "React", "Node.js", "OpenCV"],
    },
    {
        title: "Datos & hardware",
        items: ["PostgreSQL", "Arduino", "IoT", "Machine Learning"],
    },
];

const skillTreeLines = [
    "skills/",
    ...skills.flatMap((group, groupIndex) => {
        const isLastGroup = groupIndex === skills.length - 1;
        const groupPrefix = isLastGroup ? "    " : "│   ";

        return [
            `${isLastGroup ? "└──" : "├──"} ${group.title}/`,
            ...group.items.map(
                (skill, skillIndex) =>
                    `${groupPrefix}${skillIndex === group.items.length - 1 ? "└──" : "├──"} ${skill}`,
            ),
        ];
    }),
];

const githubUsername = "draexx";
const githubProfileUrl = `https://github.com/${githubUsername}`;
const projectConfig: { source: "manual" | "pinned" } = { source: "manual" };
const featuredProjectNames = [
    "thesis-tracker",
    "sistema-evaluacion-api",
    "qr-generator-app",
    "vartificial",
    "batallanaval",
    "tresenraya",
];
let projects: GithubRepository[] = [];
let projectsError = false;
let contributionWeeks: GithubContributionWeek[] = [];
let totalContributions = 0;
let contributionsError = false;

const githubProfileToken = import.meta.env.PROFILE_GITHUB_TOKEN;
let contributionsErrorMessage = "No se pudo consultar el calendario de contribuciones en GitHub.";

try {
    if (!githubProfileToken) {
        throw new Error("Set PROFILE_GITHUB_TOKEN to load the GitHub contribution calendar.");
    }

    const response = await fetch("https://api.github.com/graphql", {
        method: "POST",
        headers: {
            Accept: "application/vnd.github+json",
            Authorization: `Bearer ${githubProfileToken}`,
            "Content-Type": "application/json",
        },
        body: JSON.stringify({
            query: `query ContributionCalendar($login: String!) {
                user(login: $login) {
                    contributionsCollection {
                        contributionCalendar {
                            totalContributions
                            weeks {
                                contributionDays {
                                    contributionCount
                                    date
                                }
                            }
                        }
                    }
                }
            }`,
            variables: { login: githubUsername },
        }),
    });

    if (!response.ok) {
        throw new Error(`GitHub GraphQL API returned ${response.status} ${response.statusText}`);
    }

    const result: GithubContributionsResponse = await response.json();
    if (result.errors?.length) {
        throw new Error(`GitHub GraphQL API error: ${result.errors.map(({ message }) => message).join("; ")}`);
    }

    const calendar = result.data?.user?.contributionsCollection?.contributionCalendar;
    if (!calendar) {
        throw new Error(`GitHub did not return a contribution calendar for ${githubUsername}.`);
    }

    contributionWeeks = calendar.weeks;
    totalContributions = calendar.totalContributions;
} catch (error) {
    console.error("Could not load GitHub contribution calendar for /perfil:", error);
    contributionsError = true;
    if (!githubProfileToken) {
        contributionsErrorMessage =
            "Falta configurar el secreto PROFILE_GITHUB_TOKEN en GitHub Actions con permiso read:user y volver a desplegar.";
    }
}

try {
    if (projectConfig.source === "pinned") {
        if (!githubProfileToken) {
            throw new Error("Set PROFILE_GITHUB_TOKEN to load GitHub pinned repositories.");
        }

        const response = await fetch("https://api.github.com/graphql", {
            method: "POST",
            headers: {
                Accept: "application/vnd.github+json",
                Authorization: `Bearer ${githubProfileToken}`,
                "Content-Type": "application/json",
            },
            body: JSON.stringify({
                query: `query PinnedRepositories($login: String!) {
                    user(login: $login) {
                        pinnedItems(first: 6, types: REPOSITORY) {
                            nodes {
                                ... on Repository {
                                    name
                                    htmlUrl
                                    homepageUrl
                                    description
                                    primaryLanguage { name }
                                    stargazerCount
                                    pushedAt
                                    repositoryTopics(first: 4) { nodes { topic { name } } }
                                    isFork
                                    isArchived
                                }
                            }
                        }
                    }
                }`,
                variables: { login: githubUsername },
            }),
        });

        if (!response.ok) {
            throw new Error(`GitHub GraphQL API returned ${response.status} ${response.statusText}`);
        }

        const result: GithubPinnedRepositoriesResponse = await response.json();
        if (result.errors?.length) {
            throw new Error(`GitHub GraphQL API error: ${result.errors.map(({ message }) => message).join("; ")}`);
        }

        projects = (result.data?.user?.pinnedItems?.nodes ?? []).map((repository) => ({
            name: repository.name,
            html_url: repository.htmlUrl,
            homepage: repository.homepageUrl,
            description: repository.description,
            language: repository.primaryLanguage?.name ?? null,
            stargazers_count: repository.stargazerCount,
            pushed_at: repository.pushedAt,
            topics: repository.repositoryTopics.nodes.map(({ topic }) => topic.name),
            fork: repository.isFork,
            archived: repository.isArchived,
        }));
    } else {
        const response = await fetch(
            `https://api.github.com/users/${githubUsername}/repos?type=owner&sort=pushed&per_page=100`,
            { headers: { Accept: "application/vnd.github+json" } },
        );

        if (!response.ok) {
            throw new Error(`GitHub API returned ${response.status} ${response.statusText}`);
        }

        const repositories: GithubRepository[] = await response.json();
        const repositoriesByName = new Map(
            repositories.map((repository) => [repository.name.toLowerCase(), repository]),
        );
        const missingProjects = featuredProjectNames.filter(
            (name) => !repositoriesByName.has(name),
        );

        if (missingProjects.length > 0) {
            console.error(`GitHub repositories not found: ${missingProjects.join(", ")}`);
        }

        projects = featuredProjectNames.flatMap((name) => {
            const repository = repositoriesByName.get(name);
            return repository ? [repository] : [];
        });
    }
} catch (error) {
    console.error("Could not load GitHub projects for /perfil:", error);
    projectsError = true;
}
